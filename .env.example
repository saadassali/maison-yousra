# Site B — Maison Yousra. Copier en .env.local et remplir. Ne jamais commiter .env.local.
# Aucune variable secrète ne doit porter le préfixe NEXT_PUBLIC_.

# --- Site ---
# Origine du site B, sans slash final, dans sa forme unique (www ou non) : https://[domaine B]
# Obligatoire en production (le build échoue sans elle).
SITE_URL=
# Origine du site A, pour l'unique lien de pied de page. Vide : pas de lien.
SITE_A_URL=

# --- E-mail ---
# Adresse d'envoi des devis et des accusés de réception, sur un domaine vérifié dans AWS SES :
# devis@maisonyousra.ma
QUOTE_FROM_EMAIL=
# Destinataire du secours par e-mail si le webhook W1 échoue (adresse de la SARL, pas personnelle).
QUOTE_FALLBACK_EMAIL=
# Serveur d'envoi du secours : AWS SES en SMTP (SES → SMTP settings → Create SMTP credentials).
# Port 587 : STARTTLS ; 465 : TLS implicite.
SES_SAAD_MAIL_HOST=email-smtp.<région>.amazonaws.com
SES_SAAD_MAIL_PORT=587
# Nom d'utilisateur SMTP (AKIA...)
SES_SAAD_MAIL_ACCES_KEY=
# Mot de passe SMTP (secret)
SES_SAAD_MAIL_SECRET_ACCES_KEY=
# Nom de l'utilisateur IAM, pour mémoire : il ne sert pas à l'envoi
SES_SAAD_MAIL_USERNAME_IAM=

# --- Twenty : webhooks (fichier 16) ---
# W1 : réception d'une demande de devis. W8 : acceptation d'un devis.
# Les workflows sont communs aux deux sites (le champ site = SITE_B les distingue) : les URL
# peuvent être les mêmes que sur le site A. Les secrets, eux, sont propres au site B, pour
# pouvoir révoquer un site sans couper l'autre (voir DEPLOIEMENT.md).
TWENTY_W1_WEBHOOK_URL=
TWENTY_W1_WEBHOOK_SECRET=
# Lecture seule des offres VALIDE pour la fourchette (rôle « Sites », fichier 23 §6).
TWENTY_API_URL=
TWENTY_API_KEY=
# Frais fixes d'un lot en MAD, pour la formule de prix (fichier 16 §5). Vide : pas de fourchette.
DEVIS_FRAIS_LOT_MAD=
TWENTY_W8_WEBHOOK_URL=
TWENTY_W8_WEBHOOK_SECRET=

# --- Liens privés ---
# Secret des liens signés (logos, maquettes, confirmation), 32 caractères au moins :
# openssl rand -base64 48. Obligatoire en production. Le changer invalide les liens existants.
LIENS_SECRET=

# --- Stockage privé des logos et des maquettes (prompts 4 et 5) ---
# Espace compatible S3 (par exemple Cloudflare R2), jamais public ; accès par lien signé.
# Vide en développement : dossier .stockage/ (hors dépôt). Obligatoire en production.
# Point d'accès sans le nom de l'espace, ex. https://<compte>.r2.cloudflarestorage.com
UPLOADS_S3_ENDPOINT=
UPLOADS_S3_REGION=
UPLOADS_S3_BUCKET=
UPLOADS_S3_ACCESS_KEY_ID=
UPLOADS_S3_SECRET_ACCESS_KEY=

# --- Vérification du build (scripts/check-build.mjs), facultatif ---
# Fichier privé, hors dépôt : un terme interdit par ligne (fournisseurs du site A, conditionneurs).
SITE_B_FORBIDDEN_TERMS_FILE=
# Dossier du site A, pour vérifier qu'aucune image n'en vient. Le build n'en dépend pas.
SITE_A_DIR=

# --- Contenu ---
# 1 : affiche aussi les produits en brouillon (aperçu). Ignoré hors de « next dev ».
CONTENT_PREVIEW=

# --- Mesure d'audience (propre au site B, jamais partagée avec le site A) ---
# Nom de l'outil retenu. Vide : aucune mesure, aucune bannière de cookies.
NEXT_PUBLIC_MESURE_AUDIENCE=
